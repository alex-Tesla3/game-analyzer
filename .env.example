APP_ENV=production
APP_VERSION=1.0.0
LOG_LEVEL=info

# Generate with: openssl rand -hex 32
SECRET_KEY=
INITIAL_ADMIN_PASSWORD=
PAYMENT_WEBHOOK_SECRET=

ALLOW_DEMO_ACCOUNTS=false
PAYMENT_TEST_MODE=false

# Optional: show public demo banner on /showcase (e.g. https://game-analyzer.fly.dev)
PUBLIC_DEMO_BASE_URL=

# Optional integrations
STEAM_API_KEY=
GOOGLE_PLAY_CREDENTIALS=
GOOGLE_PLAY_ENDPOINT=
APPSTORE_KEY_ID=
APPSTORE_ISSUER_ID=
APPSTORE_PRIVATE_KEY=
APPSTORE_ENDPOINT=

# Optional: Waffo payment (https://waffo.com) — 一次性支付 (Acquiring API)
# 密钥来自 Waffo Merchant Portal → Integration(商户后台)
WAFFO_API_KEY=
WAFFO_PRIVATE_KEY=
WAFFO_PUBLIC_KEY=
WAFFO_MERCHANT_ID=
# sandbox | production
WAFFO_ENV=sandbox
# 订单币种,默认 CNY
WAFFO_ORDER_CURRENCY=CNY

# Optional: Waffo Pancake (https://docs.waffo.ai) — 推荐
# 凭据来自 Waffo Pancake Dashboard → API & Development
# 可用 scripts/configure_waffo_pancake.py 自动创建商品/注册回调并写入 .env
WAFFO_PANCAKE_MERCHANT_ID=MER_xxx
WAFFO_PANCAKE_STORE_ID=STO_xxx
WAFFO_PANCAKE_PRIVATE_KEY=
# test | prod (由 API Key 环境决定; 仅用于 webhook 验签公钥选择)
WAFFO_PANCAKE_ENV=test
# 各套餐对应的一次性商品 ID
WAFFO_PANCAKE_PRODUCT_ID=PROD_xxx
WAFFO_PANCAKE_PRODUCT_IDS={"pro": "PROD_xxx"}
WAFFO_PANCAKE_CURRENCY=CNY
# 可选:覆盖内置 webhook 验签公钥
# WAFFO_PANCAKE_WEBHOOK_PUBLIC_KEY=

# Optional: Google Analytics (GA4) — 默认 G-70XNK1WHPX,设空/不设则用默认
# GOOGLE_ANALYTICS_ID=G-70XNK1WHPX

# AI 数据管道 / Supabase (爬取数据、LLM标签、向量、噪音标记存这里)
# 连接串含密码,只放在本地 .env / Render Secret,不要提交仓库
SUPABASE_DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# 向量维度: OpenAI text-embedding-3-small=1536; Ollama nomic-embed-text=768
EMBEDDING_DIM=1536
# 覆盖 embedding 模型(默认按 LLM provider 自动选择)
# EMBEDDING_MODEL=text-embedding-3-small
# 报告/看板是否剔除 Agent 标记的水军评论(true/false)
REPORT_EXCLUDE_NOISE=false
# 连接重试次数(本机到 Supabase 网络间歇性时调大); SUPABASE_HOSTADDR 可固定解析 IP
SUPABASE_CONNECT_RETRIES=12
# SUPABASE_HOSTADDR=13.238.183.126
# 迁移触发密钥: Render 上加此 Secret 后, 用 X-Migrate-Secret 头调用 POST /api/agent/migrate
# MIGRATE_SECRET=your-secret

# Optional email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
