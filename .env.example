APP_ENV=production
APP_VERSION=1.0.0
LOG_LEVEL=info

# Generate with: openssl rand -hex 32
SECRET_KEY=
INITIAL_ADMIN_PASSWORD=
PAYMENT_WEBHOOK_SECRET=

ALLOW_DEMO_ACCOUNTS=false
PAYMENT_TEST_MODE=false

# Optional: show public demo banner on /showcase (e.g. https://game-analyzer.fly.dev)
PUBLIC_DEMO_BASE_URL=

# Optional integrations
STEAM_API_KEY=
GOOGLE_PLAY_CREDENTIALS=
GOOGLE_PLAY_ENDPOINT=
APPSTORE_KEY_ID=
APPSTORE_ISSUER_ID=
APPSTORE_PRIVATE_KEY=
APPSTORE_ENDPOINT=

# Optional email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
