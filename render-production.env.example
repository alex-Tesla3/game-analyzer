# Production pilot / paid — paste into Render/Railway/Fly secrets (NOT for public demo)

APP_ENV=production
APP_VERSION=1.0.0

# Render/Railway: attach managed Postgres and paste Internal Database URL
DATABASE_URL=postgresql://user:pass@host:5432/game_analyzer

ALLOW_DEMO_ACCOUNTS=false
PAYMENT_TEST_MODE=false

SECRET_KEY=
INITIAL_ADMIN_PASSWORD=
PAYMENT_WEBHOOK_SECRET=

# Optional: Stripe Checkout instead of generic webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: Waffo payment (https://waffo.com) — 一次性支付
WAFFO_API_KEY=
WAFFO_PRIVATE_KEY=
WAFFO_PUBLIC_KEY=
WAFFO_MERCHANT_ID=
# sandbox | production
WAFFO_ENV=production
WAFFO_ORDER_CURRENCY=CNY

# Optional: Waffo Pancake (https://docs.waffo.ai) — 推荐
WAFFO_PANCAKE_MERCHANT_ID=
WAFFO_PANCAKE_STORE_ID=
WAFFO_PANCAKE_PRIVATE_KEY=
WAFFO_PANCAKE_ENV=prod
WAFFO_PANCAKE_PRODUCT_ID=
WAFFO_PANCAKE_PRODUCT_IDS={"pro": "PROD_xxx"}
WAFFO_PANCAKE_CURRENCY=CNY

APP_PUBLIC_URL=https://your-app.onrender.com

PUBLIC_DEMO_BASE_URL=
PILOT_CONTACT_EMAIL=sales@yourcompany.com

LOG_LEVEL=info
